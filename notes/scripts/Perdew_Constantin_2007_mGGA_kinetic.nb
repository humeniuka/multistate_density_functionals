Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Switching", " ", "function", " ", "of", " ", 
    RowBox[{"Eqn", ".", " ", 
     RowBox[{"(", "15", ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"a", "=", "0.5389"}], "\[IndentingNewLine]", 
   RowBox[{"b", "=", "3"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fswitch", "[", "z_", "]"}], ":=", 
    RowBox[{"Piecewise", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"z", "<=", "0"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "+", 
              RowBox[{"Exp", "[", 
               RowBox[{"a", "/", 
                RowBox[{"(", 
                 RowBox[{"a", "-", "z"}], ")"}]}], "]"}]}], ")"}], "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Exp", "[", 
               RowBox[{"a", "/", "z"}], "]"}], "+", 
              RowBox[{"Exp", "[", 
               RowBox[{"a", "/", 
                RowBox[{"(", 
                 RowBox[{"a", "-", "z"}], ")"}]}], "]"}]}], ")"}]}], ")"}], 
          "^", "b"}], ",", 
         RowBox[{"0", "<=", "z", "<=", "a"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", 
         RowBox[{"a", "<=", "z"}]}], "}"}]}], "}"}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"fswitch", "[", "z", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", "0.1", ",", " ", "0.6"}], "}"}]}], "]"}]}]}]], "Input",\

