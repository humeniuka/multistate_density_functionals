Notebook[{
Cell["\<\
meta GGA kinetic energy functional
Perdew & Constantin, Phys. Rev. B 75, 155109 (2007)\
\>", "Text",
 CellChangeTimes->{{3.928441016093463*^9, 
  3.92844107621902*^9}},ExpressionUUID->"effe0398-29ed-4cf1-8db5-\
d5bb9c058030"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"4", "-", 
    RowBox[{
    "th", " ", "order", " ", "gradient", " ", "exchange", " ", "enhancement", 
     " ", "factor"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"\[CapitalDelta]", "=", 
    RowBox[{
     RowBox[{
      FractionBox["8", "81"], 
      RowBox[{"q", "^", "2"}]}], "-", 
     RowBox[{
      FractionBox["1", "9"], "p", " ", "q"}], " ", "+", 
     RowBox[{
      FractionBox["8", "243"], 
      RowBox[{"p", "^", "2"}]}]}]}], "\[IndentingNewLine]", 
   RowBox[{"fGE4", "=", 
    RowBox[{"1", "+", 
     RowBox[{
      FractionBox["5", "27"], "p"}], "+", 
     RowBox[{
      FractionBox["20", "9"], "q"}], "+", "\[CapitalDelta]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"DensityPlot", "[", 
    RowBox[{"fGE4", ",", 
     RowBox[{"{", 
      RowBox[{"p", ",", "0", ",", "10"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"q", ",", "0", ",", "10"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Axes", "->", " ", "True"}], ",", " ", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<p\>\"", ",", "\"\<q\>\""}], "}"}]}]}], "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"modified", " ", "4"}], "-", 
     RowBox[{
     "th", " ", "order", " ", "gradient", " ", "expansion", " ", 
      "enhancement", " ", "factor"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"fGE4M", "=", 
    FractionBox["fGE4", 
     SqrtBox[
      RowBox[{"1", "+", 
       RowBox[{
        RowBox[{"(", 
         FractionBox["\[CapitalDelta]", 
          RowBox[{"1", "+", 
           RowBox[{
            RowBox[{"5", "/", "3"}], " ", "p"}]}]], ")"}], "^", "2"}]}]]]}], 
   "\[IndentingNewLine]", 
   RowBox[{"DensityPlot", "[", 
    RowBox[{"fGE4M", ",", 
     RowBox[{"{", 
      RowBox[{"p", ",", "0", ",", "10"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"q", ",", "0", ",", "10"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Axes", "->", " ", "True"}], ",", " ", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<p\>\"", ",", "\"\<q\>\""}], "}"}]}]}], "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"von", "-", 
     RowBox[{"Weizs\[ADoubleDot]cker", " ", "enhancement", " ", "factor"}]}], 
    " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"fW", "=", 
    RowBox[{
     FractionBox["5", "3"], " ", 
     RowBox[{"p", "^", "2"}]}]}], "\[IndentingNewLine]", 
   RowBox[{"DensityPlot", "[", 
    RowBox[{"fW", ",", 
     RowBox[{"{", 
      RowBox[{"p", ",", "0", ",", "10"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"q", ",", "0", ",", "10"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Axes", "->", " ", "True"}], ",", " ", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<p\>\"", ",", "\"\<q\>\""}], "}"}]}]}], "]"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9284410776401863`*^9, 3.9284412013592873`*^9}, {
