  RowBox[{"Plot", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         FractionBox["2", "length"], "*", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"Sin", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"2", "*", "m"}], "+", "1"}], ")"}], "*", 
             FractionBox["\[Pi]", "length"], "*", "x"}], "]"}], ")"}], "^", 
          "2"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"m", ",", "0", ",", " ", "mmax"}], "}"}]}], "]"}], ",", 
