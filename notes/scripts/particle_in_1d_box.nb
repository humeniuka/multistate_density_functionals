Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   SqrtBox[
    RowBox[{"1", "-", 
     RowBox[{"z", "^", "2"}]}]], ",", 
   RowBox[{"{", 
    RowBox[{"z", ",", 
     RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}]], "Input",
